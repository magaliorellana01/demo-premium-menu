# Copiá este archivo a .env y completá los valores desde el dashboard de Supabase:
# Project Settings > API Keys (o "Connect").
#
# Lo que empieza con VITE_ se PUBLICA con el sitio: ahí solo van claves públicas (la URL del
# proyecto y la anon o publishable key, pensada para el navegador; lo que protege los datos son
# las políticas RLS de supabase/schema.sql). La clave secreta va aparte, más abajo.
# En este archivo (que sí se versiona) nunca se escriben valores reales.

# URL del proyecto, con este formato: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Clave pública "anon" (empieza con eyJ...) o "publishable" (empieza con sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# Dirección pública del sitio, sin barra final. Se usa para las etiquetas Open Graph
# (la vista previa al compartir necesita URLs absolutas). Vite la incorpora al hacer el build.
VITE_PUBLIC_URL=https://menu.oestack.com

# ---------------------------------------------------------------------------------------------
# Solo para scripts/verificar-permisos.mjs (npm run verificar:permisos).
# Credenciales de DOS usuarios de PRUEBA, creados a mano en Authentication > Users (ver README,
# "Usuarios del panel"). Van únicamente en tu .env (que no se versiona): nunca las commitees.
# No empiezan con VITE_, así que Vite jamás las incluye en el sitio publicado.
# ---------------------------------------------------------------------------------------------
# Usuario de prueba 1: owner del local "aroma"
TEST_USER1_EMAIL=
TEST_USER1_PASSWORD=
# Usuario de prueba 2: owner SOLO del local de prueba "local-prueba" (inactivo)
TEST_USER2_EMAIL=
TEST_USER2_PASSWORD=
# Editor y admin de prueba (opcionales). No los completes a mano: los escribe y los borra
# npm run pruebas:usuarios (ver README, "Clientes").
TEST_EDITOR_EMAIL=
TEST_EDITOR_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------
# CLAVE SECRETA: solo para los scripts de clientes que corrés en TU computadora
# (alta:cliente, cliente:*, pruebas:usuarios). Saltea TODA la seguridad de la base.
# Se consigue en Project Settings > API Keys > Secret keys (empieza con sb_secret_).
# Nunca le pongas VITE_ adelante, no la pegues en un chat y no la cargues en el hosting.
# Control: npm run verificar:secretos
# ---------------------------------------------------------------------------------------------
SUPABASE_SECRET_KEY=
